SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PYTHONPATH=/app

# Sync Ghost -> projetos agora é recebido pela API em /api/webhooks/ghost/members.
# Rode mamute_scrappers.scripts.create_users manualmente apenas para reconciliação.

# Novas proposições do Senado — incremental (a cada 6h)
5 */6 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh senado-propositions -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.proposition >> /proc/1/fd/1 2>> /proc/1/fd/2

# Novas proposições da Câmara — incremental, ano corrente (a cada 6h)
20 */6 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh camara-propositions -- /usr/local/bin/python -m mamute_scrappers.camara_crawler.proposition --year $(date +\%Y) >> /proc/1/fd/1 2>> /proc/1/fd/2

# Backfill histórico de proposições (Câmara + Senado, em fatias — a cada 1h).
# --chunks-per-run 50: com REQUEST_DELAY reduzido a 0.1s os chunks rodam rápido,
# então faz sentido consumir mais fila por execução horária. Auto-encerra quando
# termina (pending=0); rodadas subsequentes saem na hora sem fazer nada.
10 * * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh backfill-propositions -- /usr/local/bin/python -m mamute_scrappers.scripts.backfill_propositions --chunks-per-run 50 >> /proc/1/fd/1 2>> /proc/1/fd/2

# Backfill histórico de votações + discursos (Câmara + Senado, em fatias — a cada 1h,
# no minuto 40 para não coincidir com o backfill de proposições do minuto 10).
# --chunks-per-run 50: idem proposições. Auto-encerra quando termina.
40 * * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh backfill-votes-speeches -- /usr/local/bin/python -m mamute_scrappers.scripts.backfill_votes_speeches --chunks-per-run 50 >> /proc/1/fd/1 2>> /proc/1/fd/2

# Backfill da coluna vote_date em roll_call_votes (Câmara + Senado, a cada 1h
# no minuto 55 — depois do camara-speeches do minuto 52). Cada link representa
# uma votação inteira (N votos), então uma chamada HTTP popula N linhas. Com
# ~5-10k votações distintas no banco, 200 links/h consome a fila em ~1 dia.
# Auto-encerra quando termina.
55 * * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh backfill-vote-dates -- /usr/local/bin/python -m mamute_scrappers.scripts.backfill_vote_dates --chunks-per-run 200 >> /proc/1/fd/1 2>> /proc/1/fd/2

# Burst de inicialização (@reboot): ao subir o container, dispara um loop que
# esvazia a fila do backfill mais rápido do que o ritmo horário. Sai quando ve
# "Backfill completo" / "nada a fazer" no output do orquestrador. Em runs
# subsequentes (já zerado) é no-op imediato.
#
# Sleep 30s no comeco da-se margem pro container terminar o boot (DB ready, etc).
# A trava de arquivo do orquestrador (flock em backfill*.lock) garante que esse
# burst e o cron horario nao executam ao mesmo tempo: quem chegar segundo sai.
@reboot sleep 30 && cd /app && (while true; do OUT=$(/usr/local/bin/python -m mamute_scrappers.scripts.backfill_propositions --chunks-per-run 100 2>&1); echo "$OUT" | tail -3; if echo "$OUT" | grep -qE 'Backfill completo|nada a fazer'; then break; fi; sleep 5; done) >> /proc/1/fd/1 2>&1
@reboot sleep 30 && cd /app && (while true; do OUT=$(/usr/local/bin/python -m mamute_scrappers.scripts.backfill_votes_speeches --chunks-per-run 100 2>&1); echo "$OUT" | tail -3; if echo "$OUT" | grep -qE 'Backfill completo|nada a fazer'; then break; fi; sleep 5; done) >> /proc/1/fd/1 2>&1
@reboot sleep 30 && cd /app && (while true; do OUT=$(/usr/local/bin/python -m mamute_scrappers.scripts.backfill_vote_dates --chunks-per-run 500 2>&1); echo "$OUT" | tail -3; if echo "$OUT" | grep -qE 'Backfill vote_dates completo|nada a fazer'; then break; fi; sleep 5; done) >> /proc/1/fd/1 2>&1

# Atualização de trâmites/status (diário às 03h)
25 3 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh senado-proposition-status -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.proposition_status >> /proc/1/fd/1 2>> /proc/1/fd/2

# Tipos de proposição (diário às 04h)
25 4 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh senado-proposition-types -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.proposition_type >> /proc/1/fd/1 2>> /proc/1/fd/2

# Caches dos painéis admin (diário às 04h): api_coverage + snapshot da cobertura
# do banco (pesado ao vivo) + cotação USD→BRL do dia. A API só lê essas tabelas.
0 4 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh admin-caches -- /usr/local/bin/python -m mamute_scrappers.scripts.refresh_admin_caches >> /proc/1/fd/1 2>> /proc/1/fd/2

# Catálogo de planos a partir do Ghost (fonte da verdade — diário às 04h15).
# Casa por product_id (== id do tier no Ghost; "free" para o gratuito) e espelha
# nome, preço e status: cria plano novo herdando limites, marca arquivado (sem
# tirar do ar quem ainda tem assinante) e sinaliza plano sem par no Ghost. Os
# limites são do painel admin e nunca são sobrescritos aqui. O painel também
# dispara este mesmo sync sob demanda por POST /api/admin/tiers/sync.
15 4 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh ghost-tiers-sync -- /usr/local/bin/python -m mamute_scrappers.scripts.ghost_tiers_sync >> /proc/1/fd/1 2>> /proc/1/fd/2

# Votações nominais do Senado (a cada 3h)
12 */3 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh senado-roll-call-votes -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.roll_call_votes >> /proc/1/fd/1 2>> /proc/1/fd/2

# Votações nominais da Câmara (a cada 3h, no minuto 30 para não coincidir com o Senado)
42 */3 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh camara-roll-call-votes -- /usr/local/bin/python -m mamute_scrappers.camara_crawler.roll_call_votes >> /proc/1/fd/1 2>> /proc/1/fd/2

# Discursos/taquigrafias do Senado (a cada 2h)
22 */2 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh senado-speeches -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.speechs_transcipts >> /proc/1/fd/1 2>> /proc/1/fd/2

# Discursos da Câmara (a cada 2h, no minuto 30 para não coincidir com o Senado)
52 */2 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh camara-speeches -- /usr/local/bin/python -m mamute_scrappers.camara_crawler.speeches_transcripts >> /proc/1/fd/1 2>> /proc/1/fd/2

# Pautas editoriais dos parlamentares (semanal, domingo às 08h20 UTC) — CS-72
# Semanal, e não diário, porque é a velocidade do fenômeno: ninguém muda de
# pauta entre terça e quarta. Domingo de manhã pega a semana inteira de
# discurso já coletada (os coletores rodam a cada 2h, minutos 22 e 52).
# Só reclassifica quem mudou — quem está em dia é pulado sem chamar o modelo,
# então o custo em token é proporcional ao movimento, não ao tamanho da Casa.
# O run-cron-job.sh já dá lock por job; não há trava própria aqui.
20 8 * * 0 cd /app && /app/mamute_scrappers/docker/run-cron-job.sh editorial-agendas -- /usr/local/bin/python -m mamute_scrappers.scripts.classify_editorial_agendas >> /proc/1/fd/1 2>> /proc/1/fd/2

# Parlamentares da Câmara (diário às 05h30)
30 5 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh camara-parliamentarians -- /usr/local/bin/python -m mamute_scrappers.camara_crawler.parliamentarian >> /proc/1/fd/1 2>> /proc/1/fd/2

# Parlamentares do Senado (diário às 05h45)
45 5 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh senado-parliamentarians -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.parliamentarian >> /proc/1/fd/1 2>> /proc/1/fd/2

# Presença em plenário da Câmara (diário às 06h10, janela padrão de 30 dias)
10 6 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh camara-plenary-attendance -- /usr/local/bin/python -m mamute_scrappers.camara_crawler.plenary_attendance >> /proc/1/fd/1 2>> /proc/1/fd/2

# Candidaturas do TSE (DivulgaCandContas) — incremental: listagens sempre, detalhe
# só de candidatura nova ou alterada. Diário durante o período eleitoral; a situação
# (deferido/indeferido) muda por semanas após o registro de 15/08.
20 6 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh tse-candidacies -- /usr/local/bin/python -m mamute_scrappers.tse_crawler.candidacy >> /proc/1/fd/1 2>> /proc/1/fd/2

# Timeline eleitoral (histórico + patrimônio) — semeia do JSONB local (barato,
# mantém o resultado atualizado na apuração) e drena até 5000 detalhes de bens
# por dia (retomável; parlamentares primeiro, depois anos mais recentes).
50 6 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh tse-electoral-history -- /usr/local/bin/python -m mamute_scrappers.tse_crawler.electoral_history --max-details 5000 >> /proc/1/fd/1 2>> /proc/1/fd/2

# --- Relatórios por e-mail (provedor definido por MAIL_PROVIDER; hoje: Mailgun) ---
# Uma linha por periodicidade: CADA job roda no seu horário e só envia aos projetos
# cujo tier tem aquela periodicidade em `tiers.detalhes.periodicidade_email`. Assim
# o cron é maleável — quem manda no envio é a config de cada plano, não o cron. Um
# projeto sem a periodicidade correspondente simplesmente não entra na query.
# Só entrega de fato quando: (a) MAIL_PROVIDER + credenciais no .env (Mailgun entrega
# a usuários reais, sem o sandbox que o SES exigia) e (b) o tier tiver periodicidade_email.
# Horários em UTC (container TZ=UTC): 11:00 UTC = 08:00 BRT.
# NÃO agendar `total` (é modo de teste/preview, manda para todos os projetos).

# Relatório diário — todo dia, 11:00 UTC (08:00 BRT)
0 11 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh notif-day -- /usr/local/bin/python -m mamute_scrappers.scripts.notificacao --periodicidade day >> /proc/1/fd/1 2>> /proc/1/fd/2

# Relatório semanal — segundas, 11:00 UTC (08:00 BRT)
0 11 * * 1 cd /app && /app/mamute_scrappers/docker/run-cron-job.sh notif-week -- /usr/local/bin/python -m mamute_scrappers.scripts.notificacao --periodicidade week >> /proc/1/fd/1 2>> /proc/1/fd/2

# Relatório quinzenal — dias 1 e 16, 11:00 UTC (08:00 BRT). Cron não faz "a cada 15
# dias"; dias 1/16 aproximam bem (janela do relatório é fixa em 15 dias).
0 11 1,16 * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh notif-fortnight -- /usr/local/bin/python -m mamute_scrappers.scripts.notificacao --periodicidade fortnight >> /proc/1/fd/1 2>> /proc/1/fd/2

# Relatório mensal — dia 1, 11:00 UTC (08:00 BRT)
0 11 1 * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh notif-month -- /usr/local/bin/python -m mamute_scrappers.scripts.notificacao --periodicidade month >> /proc/1/fd/1 2>> /proc/1/fd/2

# Saldo do OpenRouter (de hora em hora) — CS-31.
# Em 29/07/2026 os créditos zeraram no meio da carga de embeddings e o chatbot
# saiu do ar (chat e busca vetorial em 402) sem aviso nenhum. Este job avisa os
# admins de MAMUTE_ADMIN_EMAILS antes de chegar nesse ponto.
# O próprio script controla a repetição: piora avisa na hora, mesmo estado só
# repete a cada 24h, melhora não gera e-mail. Por isso pode rodar de hora em hora.
25 * * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh openrouter-credits -- /usr/local/bin/python -m mamute_scrappers.scripts.check_openrouter_credits >> /proc/1/fd/1 2>> /proc/1/fd/2

# --- Emendas parlamentares (Portal da Transparencia) — CS-17 ---
# Exige PORTAL_TRANSPARENCIA_API_KEY no .env. Sem a chave o job sai com erro
# explicito apontando a URL de cadastro, sem derrubar mais nada.
# A fonte limita 30 req/min por chave e serve 15 registros por pagina; um ano
# tem ~400 paginas, ou seja ~15 min de coleta.

# Ano corrente (diario as 06h50 UTC = 03h50 BRT). Continua necessario mesmo
# depois que o backfill encerra: empenhado/liquidado/pago mudam o ano inteiro.
50 6 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh emendas -- /usr/local/bin/python -m mamute_scrappers.portal_crawler.emendas --ano $(date +\%Y) >> /proc/1/fd/1 2>> /proc/1/fd/2

# Planos de acao das emendas Pix (Transferegov) + prestacao de contas.
# Roda 1h depois da coleta de emendas: o plano casa por amendment_code, entao
# a emenda precisa existir primeiro. Refaz os ~58 mil planos a cada execucao;
# o upsert e idempotente, entao a primeira execucao ja e o backfill.
50 7 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh transferegov-action-plans -- /usr/local/bin/python -m mamute_scrappers.transferegov_crawler.action_plans >> /proc/1/fd/1 2>> /proc/1/fd/2

# Backfill 2022 -> ano corrente (a cada 1h no minuto 35 — livre entre os jobs
# horarios ja existentes, que ocupam 10, 25, 40 e 55). Sao ~5 chunks de um ano
# cada; com 2 por execucao a fila fecha em ~3 horas e depois vira no-op.
35 * * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh backfill-emendas -- /usr/local/bin/python -m mamute_scrappers.scripts.backfill_emendas --chunks-per-run 2 >> /proc/1/fd/1 2>> /proc/1/fd/2

# Burst de inicializacao: esvazia a fila do backfill mais rapido que o ritmo
# horario. A trava de arquivo garante que burst e cron nao rodam juntos.
@reboot sleep 45 && cd /app && (while true; do OUT=$(/usr/local/bin/python -m mamute_scrappers.scripts.backfill_emendas --chunks-per-run 1 2>&1); echo "$OUT" | tail -3; if echo "$OUT" | grep -qE 'Backfill de emendas completo|nada a fazer'; then break; fi; sleep 5; done) >> /proc/1/fd/1 2>&1

# --- Cota parlamentar (CEAP Camara + CEAPS Senado) — CS-57 ---
# Camara: arquivo anual em massa (a API REST de despesas esta degradada — ver
# camara_crawler/expenses.py). Senado: API JSON de dados abertos. Sem chave de
# API e sem rate limit relevante: e 1 download por ano x casa.

# Ano corrente (diario, depois das emendas das 06h50: Camara 07h15, Senado
# 07h30 UTC). Continua necessario apos o backfill: valor e glosa mudam
# retroativamente o ano inteiro.
15 7 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh cota-camara -- /usr/local/bin/python -m mamute_scrappers.camara_crawler.expenses --ano $(date +\%Y) >> /proc/1/fd/1 2>> /proc/1/fd/2
30 7 * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh cota-senado -- /usr/local/bin/python -m mamute_scrappers.senado_crawler.expenses --ano $(date +\%Y) >> /proc/1/fd/1 2>> /proc/1/fd/2

# Backfill 2022 -> ano corrente (a cada 1h no minuto 20 — livre entre os jobs
# horarios, que ocupam 10, 25, 35, 40 e 55). Sao 10 chunks ano x casa; com 2
# por execucao a fila fecha em ~5 horas e depois vira no-op.
20 * * * * cd /app && /app/mamute_scrappers/docker/run-cron-job.sh backfill-cota -- /usr/local/bin/python -m mamute_scrappers.scripts.backfill_cota --chunks-per-run 2 >> /proc/1/fd/1 2>> /proc/1/fd/2

# Burst de inicializacao da cota: mesma mecanica do burst de emendas.
@reboot sleep 60 && cd /app && (while true; do OUT=$(/usr/local/bin/python -m mamute_scrappers.scripts.backfill_cota --chunks-per-run 1 2>&1); echo "$OUT" | tail -3; if echo "$OUT" | grep -qE 'Backfill de cota completo|nada a fazer'; then break; fi; sleep 5; done) >> /proc/1/fd/1 2>&1
